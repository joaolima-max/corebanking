# ---- Deploy (self-host) env — copy to .env and fill ----
POSTGRES_DB=corebanking
POSTGRES_USER=corebanking
POSTGRES_PASSWORD=change-me-strong

# Public URLs (browser calls the API from these origins)
NEXT_PUBLIC_API_URL=https://api.seu-dominio.com
ALLOWED_ORIGINS=https://admin.seu-dominio.com,https://app.seu-dominio.com

# JWT (opcional no MVP: se vazio, o servidor gera par efêmero — tokens caem no restart)
# Para tokens estáveis, gere e cole as PEMs RSA:
#   openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
