# Application
NODE_ENV=development
PORT=3000
APP_NAME="Bass Financial Core"

# Database (Supabase: use pooler URL para queries, DIRECT_URL para migrations)
DATABASE_URL="postgresql://corebanking:corebanking@localhost:5432/corebanking_dev?schema=public"
DIRECT_URL="postgresql://corebanking:corebanking@localhost:5432/corebanking_dev"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT — generate with: openssl genrsa -out private.pem 4096 && openssl rsa -in private.pem -pubout -out public.pem
# Then base64 encode: base64 -w 0 private.pem
JWT_PRIVATE_KEY="<base64-encoded-private-pem>"
JWT_PUBLIC_KEY="<base64-encoded-public-pem>"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Throttling
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# CORS — comma-separated list of allowed origins (REQUIRED in production)
# Example: ALLOWED_ORIGINS="https://app.basspago.com.br,https://admin.basspago.com.br"
ALLOWED_ORIGINS=""
